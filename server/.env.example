# SMTP configuration for registration confirmation emails.
# Copy this file to .env and fill in your real credentials.
# Never commit .env — it is already git-ignored.

SMTP_HOST=smtp.gmail.com          # e.g. smtp.gmail.com, smtp.office365.com, smtp.mailgun.org
SMTP_PORT=587                     # 587 for STARTTLS, 465 for SSL
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password   # use an app password for Gmail / provider-specific secret
SMTP_USE_TLS=true                 # false → use SMTP_SSL on SMTP_PORT instead
EMAIL_FROM=attendance@nihub.edu   # sender address visible to recipients
