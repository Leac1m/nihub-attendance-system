# Top-level gitignore for the repository

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# IDEs and editor files
.vscode/
.idea/
.DS_Store

qr_codes/
uploads/

.kilo/
.env